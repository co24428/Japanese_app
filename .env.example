# Copy this file to `.env.local` for local development.
# On Vercel, set the same names under Project -> Settings -> Environment Variables.

# The password you type on the login screen. Pick something long.
APP_PASSWORD=change-me

# Secret used to (1) sign the login cookie and (2) encrypt your AI API keys
# before they are stored in the database. Generate one with:
#   openssl rand -base64 32
# If you change it later you will be logged out and must re-enter your AI keys.
APP_SECRET=replace-with-a-long-random-string

# Postgres connection string. Vercel Postgres / Neon sets this for you
# (either DATABASE_URL or POSTGRES_URL works).
# Leave it empty locally: the app then uses an embedded database in ./.data
DATABASE_URL=
